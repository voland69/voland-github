// VOLCANIC - archmage-f - TRUE SKILLS from Mage-F-New.html - FIXED 2026-10-25 v2 FINAL
function applyVolcanicSkills(sName, battle){
  if(battle.hero.spellCount && battle.hero.spellCount % 4 === 0){
    battle.enemy.calderaTurns = 2;
    if(typeof addBattleLog==='function') addBattleLog('🌋 Сердце Кальдеры: земля горит 100% AOE 2 раунда!', 'crit');
  }
  if(sName.includes('Огненный Шар')){
    battle.enemy.burnTurns = 2;
    battle.enemy.burnPct = 20;
    if(typeof addBattleLog==='function') addBattleLog('🔥 Огненный Шар: 150% + поджог 20% 2 раунда, крит = AOE всем', 'crit');
  }
  if(sName.includes('Извержение')){
    battle.enemy.lavaTurns = 3;
    battle.enemy.lavaPct = 50;
    if(typeof addBattleLog==='function') addBattleLog('💥 Извержение: 200% AOE + лава 50% 3 раунда', 'crit');
  }
  if(sName.includes('Метеор') && !sName.includes('Судный')){
    battle.enemy.meteorWave = 1;
    battle.enemy.meteorWaveDelay = 1;
    battle.enemy.meteorWaveDmg = 300;
    if(typeof addBattleLog==='function') addBattleLog('☄️ Метеор: 500% + волна 300% в след. раунде', 'crit');
  }
  if(sName.includes('Судный День')){
    battle.enemy.judgmentTurns = 4;
    battle.enemy.judgmentCount = 0;
    if(typeof addBattleLog==='function') addBattleLog('🌋 Судный День: 4 метеора по 200% + финал 400% + поджог 50% 2 раунда', 'crit');
  }
}
