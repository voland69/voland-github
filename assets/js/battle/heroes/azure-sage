// AZURE SAGE - archmage-m - TRUE SKILLS from Archmage-M.html - FIXED 2026-10-25 FINAL - ONLY AZURE SAGE
function applyAzureSageSkills(sName, battle){
  // Работаем только если герой AZURE SAGE
  try{
    let heroName = (battle.heroName||'') + ' ' + (battle.hero && battle.hero.n ? battle.hero.n : '');
    // Доп проверка через глобальную heroData если есть
    if(typeof heroData!=='undefined' && heroData && heroData.n && !heroData.n.includes('AZURE SAGE') && !heroData.n.includes('archmage-m')) {
      // если глобальная heroData не AZURE SAGE, не применять
      // но battle может быть без heroData, поэтому проверяем также имя скилла - если скилл AZURE SAGE, применяем даже без проверки имени
      if(!['Искривление','Ледяное Копье','Сфера Бури','Лавина','Аннигиляция'].some(k=>sName.includes(k))) return;
    }
  }catch(e){}

  // PASSIVE: Искривление Времени
  if(battle.hero && typeof battle.hero.timeStacks==='undefined') battle.hero.timeStacks = 0;
  if(battle.hero && battle.hero.spellCount && battle.hero.spellCount > 0){
    if(!sName.includes('Искривление')){
      battle.hero.timeStacks = Math.min(5, (battle.hero.timeStacks||0)+1);
      if(battle.hero.timeStacks === 5){
        battle.hero.timeBonus = true;
        if(typeof addBattleLog==='function') addBattleLog('⏳ Искривление Времени: 5 стаков! След. заклинание +50% урона', 'crit');
      } else {
        if(typeof addBattleLog==='function') addBattleLog('⏳ Искривление Времени: '+battle.hero.timeStacks+' стаков (+'+(battle.hero.timeStacks*10)+'% урона)', 'skill');
      }
    }
  }

  if(sName.includes('Ледяное Копье')){
    battle.enemy.defDebuffTurns = 3;
    battle.enemy.defDebuffPct = 20;
    if(typeof addBattleLog==='function') addBattleLog('❄️ Ледяное Копье: 250% + DEF -20% 3 раунда', 'crit');
  }
  if(sName.includes('Сфера Бури')){
    // По твоей правке: сразу 160% - 1 тик, потом еще 2 раунда по 160% = всего 3 хита
    // Базовый урон 160% уже нанесен в page8 через mult, осталось 2 тика
    battle.enemy.stormSphereTurns = 2;
    battle.enemy.stormSpherePct = 160;
    battle.enemy.stormSphereTargets = 3;
    if(typeof addBattleLog==='function') addBattleLog('⚡ Сфера Бури: 160% сразу + еще 2 раунда по 160%', 'crit');
  }
  if(sName.includes('Лавина')){
    if(typeof addBattleLog==='function') addBattleLog('🏔️ Лавина: 300% всем врагам', 'crit');
  }
  if(sName.includes('Аннигиляция Времени')){
    battle.enemy.timeFreezeTurns = 3;
    battle.enemy.timeFreezeExplosion = 350;
    battle.enemy.stunned = Math.max(battle.enemy.stunned||0, 3); // доп стан для страховки
    if(typeof addBattleLog==='function') addBattleLog('🌌 Аннигиляция Времени: заморозка 3 раунда + взрыв 350% всем', 'crit');
  }
}
